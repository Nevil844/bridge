// Prisma Schema for Bridge AI - Chatbot with Memory & MCP Integrations
// Stack: PostgreSQL + pgvector for semantic embeddings

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ============================================
// USER MODEL
// ============================================
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  plan      String   @default("free") // "free", "pro", "power", "enterprise"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  conversations    Conversation[]
  userIntegrations UserIntegration[]
  memoryVectors    MemoryVector[]
  tokenUsage       TokenUsage[]

  @@index([email])
  @@index([plan])
  @@map("users")
}

// ============================================
// CONVERSATION MODEL
// ============================================
model Conversation {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("New Chat")
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]
  toolContexts  ToolContext[]
  memoryVectors MemoryVector[]

  @@index([userId, lastActive(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("conversations")
}

// ============================================
// MESSAGE MODEL
// ============================================
model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant" | "system" | "tool"
  content        String   @db.Text
  metadata       Json?    // Store tool_calls, function results, model info, etc.
  createdAt      DateTime @default(now())

  // Relations
  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memoryVectors MemoryVector[]

  @@index([conversationId, createdAt])
  @@index([role])
  @@map("messages")
}

// ============================================
// TOOL CONTEXT MODEL
// Multi-step tool execution state management
// ============================================
model ToolContext {
  id             String   @id @default(cuid())
  conversationId String
  toolName       String   // e.g., "github", "zomato", "spotify"
  state          Json     // Stores active tool state (cart, PR draft, playlist, etc.)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, isActive])
  @@index([toolName, isActive])
  @@map("tool_contexts")
}

// ============================================
// MEMORY VECTOR MODEL
// Semantic embeddings for RAG and long-term memory
// ============================================
model MemoryVector {
  id             String                         @id @default(cuid())
  userId         String
  conversationId String?
  messageId      String?
  embedding      Unsupported("vector(1024)")    // pgvector for semantic search (supports Titan v2)
  content        String                         @db.Text // Original text that was embedded
  metadata       Json?                          // Store additional context, tags, importance score
  createdAt      DateTime                       @default(now())

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([conversationId])
  @@map("memory_vectors")
}

// ============================================
// USER INTEGRATION MODEL
// MCP OAuth credentials & integration configs
// ============================================
model UserIntegration {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // "github", "google-drive", "zomato", "spotify", etc.
  credentials Json     // Store OAuth tokens, API keys (encrypt in production!)
  metadata    Json?    // Store integration-specific config, user preferences
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider]) // One integration per provider per user
  @@index([userId, isActive])
  @@index([provider])
  @@map("user_integrations")
}

// ============================================
// TOKEN USAGE MODEL (Optional - for billing)
// Track monthly AI token consumption
// ============================================
model TokenUsage {
  id           String   @id @default(cuid())
  userId       String
  month        String   // Format: "2025-01" for easy querying
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  creditsUsed  Decimal   @default(0) @db.Decimal(10, 2) // Credits consumed (rounded to 2 decimals)
  model        String?  // Track which model was used
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, model])
  @@index([userId, month])
  @@map("token_usage")
}

// ============================================
// WAITLIST MODEL
// Email signups for launch notification
// ============================================
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  isInvited Boolean  @default(false) // If true, user can access the app
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([isInvited])
  @@map("waitlist")
}

