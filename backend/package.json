{
  "name": "bridge-ai-backend",
  "version": "1.0.0",
  "description": "Backend for Bridge AI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "bash scripts/setup-db.sh",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
