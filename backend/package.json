    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@prisma/client": "^6.19.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "form-data": "^4.0.4",
    "googleapis": "^164.0.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openai": "^6.8.1",
    "pgvector": "^0.2.1",
    "prisma": "^6.19.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.3",
    "expo": "~54.0.15",
